# ---------------------------------------------------------------------------
# Offline-First Disaster Relief Distribution & Coordination System
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (runtime + migrations).
DATABASE_URL="postgresql://relief:relief_dev_pw@localhost:5432/disaster_relief?schema=public"

# HS256 secret for session JWTs signed with `jose`. Must be >= 32 random bytes.
# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET="replace-with-output-of-openssl-rand-base64-48"

# Session lifetime in hours (field devices may stay offline for long stretches).
AUTH_SESSION_TTL_HOURS="72"

# Account lockout policy: lock after N consecutive failed logins for M minutes.
AUTH_MAX_FAILED_ATTEMPTS="5"
AUTH_LOCKOUT_MINUTES="15"

# Duplicate-detection thresholds. Pairs scoring >= LIKELY are labelled
# "Likely"; >= POSSIBLE and < LIKELY are labelled "Possible"; lower scores are ignored.
DUPLICATE_LIKELY_THRESHOLD="0.85"
DUPLICATE_POSSIBLE_THRESHOLD="0.65"

# Window (hours) for flagging cross-organisation repeat distributions to one household.
REPEAT_DISTRIBUTION_WINDOW_HOURS="24"

# A volunteer may void their own distribution only within this many hours of recording it.
VOID_WINDOW_HOURS="24"

# Closed operations have household PII redacted after this many days (NFR07).
PII_RETENTION_DAYS="90"

# Public base URL (used in notification links and PWA manifest scope).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seeding: `prisma/seed.ts` TRUNCATES every table. It refuses to run when
# NODE_ENV=production unless this is set to "true".
ALLOW_DESTRUCTIVE_SEED="false"

# Shows the "Capstone Demo Accounts" one-click panel on /login. Demo/local databases ONLY:
# leave unset or "false" on any real deployment (the panel lists seeded passwords).
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="true"
